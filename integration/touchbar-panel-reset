#!/usr/bin/bash
# Recover the Touch Bar display after resume.
#
# After suspend the T2's display endpoint (USB 05ac:8302, driver appletbdrm)
# can come back wedged: every DRM flush times out with "Failed to send
# message (-110)" and the panel freezes on its last frame while touch input
# keeps working, so the bar looks hung even though the daemon and tiny-dfr
# are fine.
#
# /etc/touchbar-panel-reset.conf picks the recovery (mode=...):
#
#   restart  (default) Restart tiny-dfr and nothing else. A wedged panel can
#            stay blank until tiny-dfr is restarted again, but no device on
#            the t2bce USB bridge is reset across the sleep boundary.
#   rebind   Also unbind and rebind appletbdrm, which clears a wedged panel.
#            It resets a device on the same bridge as the internal keyboard;
#            other T2 users have linked such resets to hangs on resume.
set -u

conf=/etc/touchbar-panel-reset.conf
mode=restart
if [[ -r $conf ]]; then
  value=$(/usr/bin/sed -n 's/^[[:space:]]*mode[[:space:]]*=[[:space:]]*\([a-z]*\).*/\1/p' "$conf" | /usr/bin/tail -n 1)
  [[ -n $value ]] && mode=$value
fi

if [[ $mode != rebind ]]; then
  [[ $mode == restart ]] || echo "Unknown mode '$mode' in $conf; using restart." >&2
  /usr/bin/systemctl restart tiny-dfr.service 2>/dev/null || true
  exit 0
fi

driver=/sys/bus/usb/drivers/appletbdrm
[[ -d $driver ]] || exit 0

shopt -s nullglob
interfaces=("$driver"/*:*)
[[ ${#interfaces[@]} -gt 0 ]] || exit 0

# tiny-dfr holds the DRM device open (and is bound to it via BindsTo), so it
# is stopped around the rebind.
/usr/bin/systemctl stop tiny-dfr.service 2>/dev/null || true
for path in "${interfaces[@]}"; do
  iface=${path##*/}
  echo "$iface" > "$driver/unbind" 2>/dev/null || true
  /usr/bin/sleep 1
  echo "$iface" > "$driver/bind" 2>/dev/null || true
done
/usr/bin/systemctl start tiny-dfr.service 2>/dev/null || true
exit 0
