# Generated by install.sh for @USER@. Grants exactly what the daemon reads and
# writes, instead of membership in the input group (which can read every
# keyboard on the machine).
#
# Touch Bar digitizer: touches on the strip.
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Apple Inc. Touch Bar Display Touchpad", \
  RUN+="/usr/bin/setfacl -m u:@USER@:r $devnode"
# Internal keyboard: the Fn key toggles the controls page.
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Apple Inc. Apple Internal Keyboard / Trackpad", \
  RUN+="/usr/bin/setfacl -m u:@USER@:r $devnode"
# Touch Bar backlight: held on while dictating or while Claude works, because
# tiny-dfr blacks the panel out after 60s of no input.
ACTION=="add", SUBSYSTEM=="backlight", KERNEL=="appletb_backlight", \
  RUN+="/usr/bin/chgrp @GROUP@ /sys/class/backlight/appletb_backlight/brightness", \
  RUN+="/usr/bin/chmod g+w /sys/class/backlight/appletb_backlight/brightness"
